# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.env
.venv
env/
venv/
ENV/

# Git
.git/
.gitignore
.gitattributes

# IDE and AI Assistants (Explicitly Excluded)
.idea/
.vscode/
.claude/
.codex/
.aider/
.cursor/
*.swp
*.swo

# Testing
tests/
test/
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
pytest.ini

# Documentation
docs/
*.md
!README.md
!LICENSE

# K1 artifacts (mount as volumes instead)
artifacts/
logs/
.k1/
checkpoints/
var/
data/
outputs/
reports/
memory/
runtime/
cache/
.pytest_artifacts/

# Node modules (if building frontend in same context)
**/node_modules/
npm-debug.log
yarn-error.log

# Build artifacts
build/
dist/
**/.next/
*.egg-info/

# OS
.DS_Store
Thumbs.db

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Docker files themselves (optional, reduces context)
Dockerfile*
docker-compose*.yml
.docker/

# Secrets (safety)
*.pem
*.key
*.crt
.env.*
secrets/
