    def _parse_response(self, content: str, language: ScriptLanguage) -> Tuple[str, str]:
        """Extract code and explanation from AI response."""
        # Extract code block
        code_start = content.find("```")
        if code_start == -1:
            code_start = content.find("```code")
        
        code = ""
        explanation = content
        
        if code_start != -1:
            code_end = content.find("```", code_start + 3)
            if code_end != -1:
                code = content[code_start:code_end].strip()
                # Remove language identifier
                if code.startswith("```code"):
                    code = code[7:].strip()
                elif code.startswith("```"):
                    first_line = code.split('\n')[0]
                    if first_line.strip() != "```":
                        code = code[len(first_line):].strip()
                    else:
                        code = code[3:].strip()
                    if code.endswith("```"):
                        code = code[:-3].strip()
                
                explanation = content[code_end + 3:].strip()
        
        # Clean up explanation
        if explanation.startswith("Explanation:"):
            explanation = explanation[12:].strip()
        
        return code, explanation
    
