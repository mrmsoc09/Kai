from __future__ import annotations
from fastapi import APIRouter, Depends, HTTPException
from typing import Dict, Any, List
from core.auth import require_roles, ROLE_OPERATOR
from core.chains import build_chain

router = APIRouter(prefix='/chains', tags=['chains'], dependencies=[Depends(require_roles(ROLE_OPERATOR))])

@router.post('/build')
async # ToT expansion integrated
@router.post('/build_tot')
async def build_tot(payload: Dict[str, Any]) -> Dict[str, Any]:
    return await build(payload)

def build(payload: Dict[str, Any]) -> Dict[str, Any]:
    finds: List[Dict[str, Any]] = (payload or {}).get('findings') or []
    if not finds:
        raise HTTPException(400, 'findings required')
    return build_chain(finds)



from pathlib import Path as _P
ROOT = _P(__file__).resolve().parents[4]
GRAPH_DIR = ROOT / 'artifacts' / 'graph'
GRAPH_DIR.mkdir(parents=True, exist_ok=True)

@router.post('/persist')
async def persist(payload: Dict[str, Any]) -> Dict[str, Any]:
    run_id = (payload or {}).get('run_id')
    chain = (payload or {}).get('chain') or {}
    if not run_id or not chain:
        raise HTTPException(400, 'run_id and chain required')
    out_dir = GRAPH_DIR / run_id
    out_dir.mkdir(parents=True, exist_ok=True)
    out = out_dir / 'chain.json'
    import json
    out.write_text(json.dumps(chain, indent=2))
    return {'ok': True, 'path': str(out)}

@router.get('/get/{run_id}')
async def get_chain(run_id: str) -> Dict[str, Any]:
    p = GRAPH_DIR / run_id / 'chain.json'
    if not p.exists():
        raise HTTPException(404, 'chain not found')
    import json
    return {'run_id': run_id, 'chain': json.loads(p.read_text())}


from typing import List

def _score_chain(nodes: List[dict]) -> float:
    # business impact heuristic: privilege_gain + data_exposure + blast_radius
    sev_map = {'low':1,'medium':2,'high':3,'critical':4}
    base = sum(sev_map.get((n.get('severity') or 'low').lower(),1) for n in nodes)
    # bonus for diversity and path length
    bonus = len({n.get('category') for n in nodes if n.get('category')}) * 0.3 + (len(nodes)-1)*0.5
    return round(base + bonus, 2)

def _tot_expand(graph_nodes: List[dict], max_depth: int = 4) -> dict:
    # naive DFS over small set to produce candidate chains
    best = {'chain': [], 'score': 0.0}
    used = set()
    def dfs(path, start_idx):
        nonlocal best
        score = _score_chain(path)
        if score > best['score']:
            best = {'chain': path.copy(), 'score': score}
        if len(path) >= max_depth:
            return
        for i in range(start_idx, min(len(graph_nodes), start_idx+8)):
            n = graph_nodes[i]
            if n.get('id') in used: continue
            used.add(n.get('id'))
            path.append(n)
            dfs(path, i+1)
            path.pop()
            used.discard(n.get('id'))
    dfs([], 0)
    return best

