# {{ .ToolName }} Dockerfile
FROM {{ .BaseImage }} as builder

# Install system dependencies for build
RUN apt-get update && apt-get install -y --no-install-recommends {{ .BuildDeps }} && rm -rf /var/lib/apt/lists/*

# Clone the repository and install as a local package
WORKDIR /app
RUN git clone {{ .RepoUrl }} .
RUN pip install --no-cache-dir .

# --- Final image ---
FROM {{ .BaseImage }}

# Install runtime dependencies if specific
RUN apt-get update && apt-get install -y --no-install-recommends {{ .RuntimeDeps }} && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app /app

# Create a non-root user
RUN adduser --system --group kaiuser
USER kaiuser

# Set entrypoint and default command
ENTRYPOINT {{ .Entrypoint }}
CMD {{ .Cmd }}
