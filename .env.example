# K1 Environment Configuration
# Copy this file to .env and fill in your values

# ==================== GENERAL ====================
# Debug mode (enables verbose logging, disables rate limits)
DEBUG_MODE=false

# Application environment
ENVIRONMENT=development

# ==================== AUTHENTICATION ====================
# Development token (change this!)
K1_DEV_TOKEN=your-dev-token-change-me

# JWT Configuration (for future JWT implementation)
K1_JWT_SECRET=your-jwt-secret-change-me
K1_ACCESS_TOKEN_EXPIRY_MINUTES=60
K1_REFRESH_TOKEN_EXPIRY_DAYS=7

# ==================== DATABASE ====================
# PostgreSQL connection
DATABASE_URL=postgresql://k1:k1password@localhost:5432/k1
DATABASE_POOL_SIZE=20
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# For Docker Compose
# DATABASE_URL=postgresql://k1:k1password@postgres:5432/k1

# ==================== CACHE & QUEUE ====================
# Redis connection
REDIS_URL=redis://localhost:6379/0

# For Docker Compose
# REDIS_URL=redis://redis:6379/0

# ==================== CORS ====================
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000

# Allow credentials (cookies, auth headers)
CORS_ALLOW_CREDENTIALS=true

# ==================== SECURITY ====================
# Force HTTPS in production
K1_FORCE_HTTPS=false

# Secure cookies
K1_SECURE_COOKIES=false

# HSTS max age (in seconds)
K1_HSTS_MAX_AGE=31536000

# ==================== LLM CONFIGURATION ====================
# Default LLM provider (anthropic, openai)
LLM_PROVIDER=anthropic

# Anthropic API Key (for Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenAI API Key (if using GPT-4)
OPENAI_API_KEY=your-openai-api-key

# LLM Model for patches
K1_PATCH_LLM_MODEL=claude-opus-4-5

# LLM Model for validation
K1_VALIDATION_LLM_MODEL=claude-3-haiku-20240307

# ==================== PATCH ENGINE ====================
# Enable patch suggestions
K1_PATCH_ENGINE_ENABLED=true

# Patch validation timeout (seconds)
K1_PATCH_VALIDATION_TIMEOUT=300

# Docker image for patch validation containers
K1_PATCH_TEST_CONTAINER_IMAGE=ubuntu:22.04

# ==================== EXTERNAL APIs ====================
# Google CSE API
GOOGLE_CSE_API_KEY=your-google-cse-api-key
GOOGLE_CSE_ID=your-google-cse-id

# Shodan API (optional)
SHODAN_API_KEY=your-shodan-api-key

# VirusTotal API (optional)
VIRUSTOTAL_API_KEY=your-virustotal-api-key

# ==================== BUG BOUNTY PLATFORMS ====================
# HackerOne API (optional, for future use)
HACKERONE_API_KEY=your-hackerone-api-key

# Bugcrowd API (optional, for future use)
BUGCROWD_API_KEY=your-bugcrowd-api-key

# ==================== EMAIL CONFIGURATION ====================
# SMTP configuration (for email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@k1.local

# ==================== VAULT CONFIGURATION ====================
# HashiCorp Vault (optional, for production)
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=root
VAULT_NAMESPACE=k1

# ==================== LOGGING ====================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file location
LOG_FILE=artifacts/logs/k1.log

# ==================== RATE LIMITING ====================
# Rate limiting backend (redis or memory)
K1_RATELIMIT_BACKEND=memory

# Default rate limits per minute
K1_RATELIMIT_DEFAULT_PER_USER=100
K1_RATELIMIT_DEFAULT_PER_IP=1000

# ==================== FEATURE FLAGS ====================
# Enable/disable features without code changes
FEATURE_PATCH_ENGINE=true
FEATURE_AUTO_VALIDATION=true
FEATURE_AUTO_SCHEDULING=false
FEATURE_PLATFORM_SUBMISSIONS=false

# ==================== SCANNING CONFIGURATION ====================
# OSINT scanning enabled
OSINT_ENABLED=true

# External queries enabled (requires explicit approval)
EXTERNAL_QUERIES_ENABLED=false

# Nuclei templates enabled
NUCLEI_ENABLED=true

# ==================== MISCELLANEOUS ====================
# API documentation URL
API_DOCS_URL=http://localhost:8080/docs

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:8081

# Backend URL
BACKEND_URL=http://localhost:8080
