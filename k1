#!/bin/bash

# Kaison K1 - Unified Control Script
# Usage: ./k1 [start|stop|restart|setup|logs|help]

set -e

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

BANNER="
${GREEN}
  _  __     _                  _  __  _ 
 | |/ /    (_)                | |/ / / |
 | ' / __ _ _ ___  ___  _ __  | ' /  | |
 |  < / _\` | / __|/ _ \| '_ \ |  <   | |
 | . \ (_| | \__ \ (_) | | | || . \  | |
 |_|\_\__,_|_|___/\___/|_| |_||_|\_\ |_|
                                        
      ENTERPRISE SECURITY PLATFORM
${NC}
"

function print_banner() {
    echo -e "$BANNER"
}

function check_dependencies() {
    if ! command -v docker &> /dev/null; then
        echo -e "${RED}Error: docker is not installed.${NC}"
        exit 1
    fi
    if ! command -v docker-compose &> /dev/null; then
        echo -e "${RED}Error: docker-compose is not installed.${NC}"
        exit 1
    fi
    if ! command -v python3 &> /dev/null; then
        echo -e "${RED}Error: python3 is not installed.${NC}"
        exit 1
    fi
}

function setup() {
    print_banner
    echo -e "${BLUE}Starting Configuration Wizard...${NC}"
    python3 configure_k1.py
}

function start() {
    if [ ! -f .env ]; then
        echo -e "${YELLOW}Configuration not found. Running setup first...${NC}"
        setup
    fi
    
    print_banner
    echo -e "${BLUE}Starting Kaison K1 Platform...${NC}"
    
    # Ensure correct permissions for data dirs
    mkdir -p artifacts
    
    sudo docker-compose -f docker-compose.dev.yml up --build -d
    
    echo -e "\n${GREEN}✓ Platform Started Successfully!${NC}"
    echo -e "------------------------------------------------"
    echo -e "Frontend Dashboard:  ${YELLOW}http://localhost:8081${NC}"
    echo -e "Backend API:         ${YELLOW}http://localhost:8080/docs${NC}"
    echo -e "MailHog (Email):     ${YELLOW}http://localhost:8025${NC}"
    echo -e "Vault UI:            ${YELLOW}http://localhost:8200${NC}"
    echo -e "------------------------------------------------"
    echo -e "To import your 75+ API keys, go to Settings -> Key Management"
    echo -e "or use the new 'Kaison Composer' AI engine."
    echo -e "------------------------------------------------"
}

function stop() {
    echo -e "${BLUE}Stopping Kaison K1 Platform...${NC}"
    sudo docker-compose -f docker-compose.dev.yml down
    echo -e "${GREEN}✓ Systems stopped.${NC}"
}

function restart() {
    stop
    start
}

function logs() {
    sudo docker-compose -f docker-compose.dev.yml logs -f
}

# Main Logic
check_dependencies

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        restart
        ;;
    setup)
        setup
        ;;
    logs)
        logs
        ;;
    *)
        print_banner
        echo "Usage: ./k1 {start|stop|restart|setup|logs}"
        exit 1
        ;;
esac
