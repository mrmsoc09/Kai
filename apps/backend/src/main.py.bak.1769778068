
from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
from routers import programs, orchestrator, chains, embeddings, recordings, submissions, planner, chains, export, scope, submissions, dorks, scans, knowledge, metrics, graph, logs, findings, runs
from routers import programs, orchestrator, chains, embeddings, recordings, submissions, planner, chains, export, scope, submissions, docs

app = FastAPI(title="K1 Backend")
app.add_middleware(CORSMiddleware, allow_origins=["*"], allow_methods=["*"], allow_headers=["*"], allow_credentials=True)
app.include_router(dorks.router)
app.include_router(scans.router)
app.include_router(knowledge.router)
app.include_router(metrics.router)
app.include_router(graph.router)
app.include_router(logs.router)
app.include_router(findings.router)
app.include_router(runs.router)

@app.get("/health")
def health():
    return {"status": "ok"}

