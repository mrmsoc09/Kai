# Kai MVP minimum environment profile
# Copy to .env for local MVP validation. This file intentionally includes only
# minimum required values for the canonical backend + operator cockpit flow.

ENVIRONMENT=development
DEBUG_MODE=true
LOG_LEVEL=INFO

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
BACKEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

DATABASE_URL=postgresql://k1:k1password@localhost:5432/k1
REDIS_URL=redis://localhost:6379/0

# Required for local auth bootstrap and JWT issuance
K1_DEV_TOKEN=replace-with-strong-dev-token
JWT_SECRET_KEY=replace-with-strong-jwt-secret
K1_JWT_SECRET=replace-with-strong-jwt-secret
JWT_ALGORITHM=HS256
K1_BOOTSTRAP_ADMIN_ENABLED=true
K1_BOOTSTRAP_ADMIN_USERNAME=k1-admin
K1_BOOTSTRAP_TENANT_NAME=kai-local

# Canonical paths for workflow + scope controls
K1_TOOL_REGISTRY_PATH=tools/registry/tool_registry.yaml
K1_SCOPE_POLICY_PATH=config/scope_guardrails.yaml
K1_WORKFLOW_OUTPUT_ROOT=output
K1_ARTIFACTS_ROOT=artifacts

# Local CORS defaults for operator frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
CORS_ALLOW_CREDENTIALS=true

# Keep startup checks practical for local MVP
K1_STARTUP_VALIDATE_DEPENDENCIES=true
K1_STARTUP_VALIDATE_SECRETS=true
K1_STARTUP_VALIDATE_TOOLPACKS=false
