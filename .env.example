# K1 environment template
# Copy to .env and replace all placeholder values before deployment.

# ==================== Runtime ====================
ENVIRONMENT=development
DEBUG_MODE=false
LOG_LEVEL=INFO

# ==================== API ====================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
BACKEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8081

# Development-only auth flow: temporary certificates are preferred over hardcoded tokens.
K1_ENABLE_BOOTSTRAP_AUTH_BUILD=true
K1_DEV_CERT_AUTH_ENABLED=true
K1_DEV_AUTH_CA_PATH=dev-certs/ca.crt.pem

# ==================== Authentication / JWT ====================
# Use >= 32 random bytes (base64 or hex) in production.
K1_JWT_SECRET=replace-with-strong-jwt-secret
JWT_SECRET_KEY=replace-with-strong-jwt-secret
JWT_ALGORITHM=HS256
K1_ACCESS_TOKEN_EXPIRY_MINUTES=60
K1_REFRESH_TOKEN_EXPIRY_DAYS=7

# Local bootstrap admin account (non-production only by default)
K1_BOOTSTRAP_ADMIN_ENABLED=true
K1_BOOTSTRAP_ADMIN_USERNAME=k1-admin
K1_BOOTSTRAP_TENANT_NAME=kai-local

# Legacy API-key auth surface (to be phased out by JWT)
ADMIN_API_KEY=replace-with-strong-admin-api-key
USER_API_KEY=replace-with-strong-user-api-key

# ==================== Database (PostgreSQL) ====================
DATABASE_URL=postgresql://k1:k1password@localhost:5432/k1
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# Optional discrete PG vars (if your tooling requires them)
POSTGRES_DB=k1
POSTGRES_USER=k1
POSTGRES_PASSWORD=k1password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
K1_POSTGRES_HOST_BIND=127.0.0.1
K1_POSTGRES_HOST_PORT=5432
K1_POSTGRES_IMAGE=postgres:16-alpine

# ==================== Cache / Queue (Redis) ====================
REDIS_URL=redis://localhost:6379/0
K1_REDIS_HOST_BIND=127.0.0.1
K1_REDIS_HOST_PORT=6379
K1_STARTUP_ENABLE_INTELLIGENCE=false
K1_STARTUP_ENABLE_RAG=false
K1_STARTUP_OPTIONAL_INIT_TIMEOUT_SECONDS=8

# ==================== Sovereign Network Layer ====================
# Startup will abort if a sovereign tunnel is not detected.
K1_ENFORCE_SOVEREIGN_NETWORK=true
# Local development escape hatch (non-production only).
# WARNING: Never use this for real-world scanning.
K1_ALLOW_INSECURE_LOCAL_START=false
# In non-production, failing docker auth check becomes a warning unless this is true.
# In production, docker auth is always required.
K1_STRICT_DOCKER_AUTH=false
# Active egress interface must be one of these.
K1_VPN_ALLOWED_INTERFACES=tun*,wg*,vpn*,snl*
# Optional explicit local VPN bridge interface.
K1_VPN_BRIDGE_INTERFACE=
# Optional override if route-based detection is not desired.
K1_ACTIVE_VPN_INTERFACE=
K1_VPN_CHECK_IP=1.1.1.1
# External egress IP API used for leak checks.
K1_EGRESS_IP_API=https://ipinfo.io/ip
# Comma-separated CIDRs for your local ISP/home egress ranges.
# Example: 203.0.113.0/24,2001:db8:1234::/48
K1_LOCAL_ISP_CIDRS=
# Optional residential proxy verification.
K1_USE_PROXIES=false
K1_RESIDENTIAL_PROXY_URL=
K1_PROXY_HEALTHCHECK_URL=https://example.com
K1_PROXY_HEAD_TIMEOUT_SECONDS=10
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost,postgres,redis,vault,ollama
no_proxy=127.0.0.1,localhost,postgres,redis,vault,ollama

# ==================== CORS ====================
# Comma-separated list; never use wildcard in production.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# ==================== LLM Providers ====================
LLM_PROVIDER=anthropic
# Preferred/fallback provider chain used by startup validation and runtime routing.
K1_PRIMARY_LLM_PROVIDER=anthropic
K1_FALLBACK_LLM_PROVIDERS=openai,gemini,ollama
ANTHROPIC_API_KEY=replace-with-anthropic-key
OPENAI_API_KEY=replace-with-openai-key
OPENROUTER_API_KEY=replace-with-openrouter-key
GOOGLE_API_KEY=replace-with-google-key

# Role-based model routing
KAI_MODEL_PROVIDER=auto
KAI_OPENROUTER_DISCOVERY_ENABLED=true
KAI_LOCAL_LLM_BASE_URL=
KAI_LOCAL_BULK_MODEL=
KAI_LOCAL_CODING_MODEL=
KAI_LOCAL_PREMIUM_MODEL=
KAI_MODEL_ROUTE_BULK=deepseek/deepseek-v4-flash
KAI_MODEL_ROUTE_CODING=qwen/qwen3.5-27b
KAI_MODEL_ROUTE_PREMIUM=moonshotai/kimi-k2.5
KAI_MODEL_ROUTE_FREE_PREMIUM=moonshotai/kimi-k2.6:free

# Qdrant Vector Store
# Set QDRANT_URL to enable Qdrant (e.g., http://localhost:6333 or your Qdrant Cloud URL)
# QDRANT_API_KEY is optional for local instances but required for Qdrant Cloud
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=k1_collection

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
K1_OLLAMA_MODEL=llama3.1:8b
K1_GEMMA_MODEL=gemma:7b
# Local-only guardrails (example defaults)
K1_OLLAMA_ALLOWED_MODELS=qwen2.5-coder:7b,llama3.1:8b,gemma:7b
K1_MAX_LOCAL_MODEL_B=9
K1_OLLAMA_AUTO_PULL=true
# Set true when you run Ollama as a host service and do not want Docker to manage k1_ollama.
K1_OLLAMA_MANAGED_EXTERNALLY=false

# Model selection knobs
K1_PATCH_LLM_MODEL=claude-opus-4-5
K1_VALIDATION_LLM_MODEL=claude-3-haiku-20240307

# ==================== Integrations ====================
# Vault
K1_SECRET_BACKEND=env
K1_VAULT_HOST_BIND=127.0.0.1
K1_VAULT_HOST_PORT=8200
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=replace-with-vault-token
VAULT_NAMESPACE=k1
VAULT_MOUNT_POINT=secret
VAULT_SECRET_PREFIX=kai

# TheHive
THEHIVE_URL=http://localhost:9000
THEHIVE_API_KEY=replace-with-thehive-key

# Cortex (TheHive Analysis Engine)
CORTEX_URL=http://localhost:9001
CORTEX_API_KEY=replace-with-cortex-api-key

# Wazuh SIEM
WAZUH_URL=https://localhost:55000
WAZUH_USERNAME=wazuh
WAZUH_PASSWORD=replace-with-wazuh-password

# Shuffle SOAR
SHUFFLE_URL=http://localhost:3001
SHUFFLE_WEBHOOK_TOKEN=replace-with-shuffle-webhook-token
# Webhook IDs for specific workflows (UUID format)
SHUFFLE_CRITICAL_FINDING_WEBHOOK_ID=replace-with-critical-finding-webhook-id
SHUFFLE_MISSION_COMPLETE_WEBHOOK_ID=replace-with-mission-complete-webhook-id
SHUFFLE_APPROVAL_WEBHOOK_ID=replace-with-approval-webhook-id
SHUFFLE_ANOMALY_WEBHOOK_ID=replace-with-anomaly-webhook-id

# MSSP (Managed Security Service Provider)
# Syslog endpoint for centralized alert aggregation
MSSP_SYSLOG_HOST=syslog.mssp.example.com
MSSP_SYSLOG_PORT=514
# Webhook secret for verifying incoming MSSP acknowledgments
MSSP_WEBHOOK_SECRET=replace-with-mssp-webhook-secret

# Wave 7 Tool Agents - Orphaned API Key Integrations
FULLHUNT_API_KEY=your_fullhunt_api_key
LEAKIX_API_KEY=your_leakix_api_key
DEHASHED_API_KEY=your_dehashed_api_key
GRAYHATWARFARE_API_KEY=your_grayhatwarfare_api_key
NVD_NIST_API_KEY=your_nvd_nist_api_key
IPINFO_API_KEY=your_ipinfo_api_key

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-neo4j-password
INTELLIGENCE_BACKGROUND_SCAN_ENABLED=false
INTELLIGENCE_SCAN_INTERVAL_MINUTES=60

# Optional external intelligence APIs
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
CENSYS_API_ID=
CENSYS_API_SECRET=

# Tool/workflow catalog and scope policies
K1_TOOL_REGISTRY_PATH=tools/registry/tool_registry.yaml
K1_SCOPE_POLICY_PATH=config/scope_guardrails.yaml

# ==================== Local Persistent Storage ====================
# Keep Kai's persistent data on the external SSD mounted at /srv/kai.
KAI_STORAGE_ROOT=/srv/kai
K1_ARTIFACTS_HOST_ROOT=/srv/kai/artifacts
K1_WORKFLOW_OUTPUT_ROOT=/srv/kai/output
K1_PGP_KEY_SOURCE_DIR=/srv/kai/keys/pgp
K1_PGP_KEY_VAULT_PATH=secret/k1/auth/pgp/kaisonai

# Optional hunter-account import source and inventory index.
KAI_HUNTER_ACCOUNTS_CSV=/home/k1-admin/Documents/Proton Shit/Proton Pass_export_2026-06-11_1781164711.csv
KAI_HUNTER_ACCOUNTS_INDEX_FILE=/srv/kai/artifacts/hunter-accounts/index.json
KAI_HUNTER_ACCOUNTS_VAULT_INDEX_PATH=k1/hunter-accounts/index

# ==================== Security Controls ====================
K1_FORCE_HTTPS=false
K1_SECURE_COOKIES=false
K1_HSTS_MAX_AGE=31536000
K1_RATELIMIT_BACKEND=memory
K1_RATELIMIT_DEFAULT_PER_USER=100
K1_RATELIMIT_DEFAULT_PER_IP=1000

# ==================== Feature Flags ====================
FEATURE_PATCH_ENGINE=true
FEATURE_AUTO_VALIDATION=true
FEATURE_AUTO_SCHEDULING=false
FEATURE_PLATFORM_SUBMISSIONS=false
OSINT_ENABLED=true
EXTERNAL_QUERIES_ENABLED=false
NUCLEI_ENABLED=true

# ==================== Artifacts / Logging ====================
LOG_FILE=/srv/kai/output/logs/k1.log
K1_ARTIFACTS_ROOT=/srv/kai/artifacts
# Docker tool artifact bind mount roots (Issue #11)
K1_ARTIFACTS_CONTAINER_ROOT=/tmp/kai-artifacts
# Daily cleanup defaults
K1_ARTIFACT_RETENTION_DAYS=14
K1_ARTIFACT_MAX_BYTES_PER_TOOL=107374182400

# ==================== Security / Auth Controls ====================
# Allow unsigned authorization certificates — NEVER enable in production.
K1_ALLOW_UNSIGNED_CERTIFICATES=false
# Signing key for authorization certificate HMAC-SHA256 signatures.
K1_AUTH_CERT_SIGNING_KEY=replace-with-strong-signing-key
# Allow development-mode Vault root token — NEVER enable in production.
K1_ALLOW_DEV_VAULT_ROOT=false
# Test-mode bypass gates — only set in isolated test environments.
K1_TEST_MODE=false
K1_RELAX_AUTH_GATES_FOR_TESTS=false

# ==================== Startup Validation ====================
# Each flag controls whether the startup check is enforced.
K1_STARTUP_VALIDATE_DEPENDENCIES=true
K1_STARTUP_VALIDATE_SECRETS=true
K1_STARTUP_VALIDATE_TOOLPACKS=false
# Bootstrap hard requirement for external recon binaries.
# Set to false for local platform bring-up without full toolchain install.
K1_BOOTSTRAP_REQUIRE_EXTERNAL_TOOLS=true

# Enforce schema migrations on backend startup.
KAI_DB_ENFORCE_MIGRATIONS=true
KAI_DB_AUTO_APPLY_MIGRATIONS=true
KAI_DB_FAIL_ON_DIRTY_SCHEMA=true

# ==================== Toolpacks ====================
# Comma-separated tool IDs to enable beyond catalog defaults.
K1_TOOLPACKS_ENABLE=
# Comma-separated tool IDs to disable regardless of catalog defaults.
K1_TOOLPACKS_DISABLE=
# Override toolpack policy file path.
# K1_TOOLPACKS_PATH=ops/toolpacks.yaml

# ==================== Scoring / Review Thresholds ====================
# Confidence score below which a finding is held for human review (0.0–1.0).
K1_CONFIDENCE_REVIEW_THRESHOLD=0.6
# Confidence score below which a finding is flagged as sensitive.
K1_CONFIDENCE_SENSITIVE_THRESHOLD=0.4
# Confidence score below which automated execution is stopped.
K1_CONFIDENCE_STOP_THRESHOLD=0.2
# Minimum compliance score (0–100) required to pass report validation.
K1_MIN_REPORT_COMPLIANCE_SCORE=70

# ==================== Submission / Attachment Limits ====================
K1_MAX_ATTACHMENT_FILE_BYTES=52428800
K1_MAX_ATTACHMENT_TOTAL_BYTES=104857600
K1_MAX_RECORDING_ATTACHMENTS=10
