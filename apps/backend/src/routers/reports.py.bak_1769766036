from fastapi import APIRouter, Depends, HTTPException
from typing import Dict, Any
from core.auth import require_roles, ROLE_OPERATOR
from core.report_formats import list_formats, get_format, render_report
from core.submissions import persist_submission
from core.report_validator import validate_rendered
from core.report_validator import validate_rendered
from core.recordings import has_recording

router = APIRouter(prefix='/reports', tags=['reports'], dependencies=[Depends(require_roles(ROLE_OPERATOR))])

@router.get('/formats')
async def formats() -> dict:
    return {'formats': list_formats()}

@router.post('/render')
async def render(payload: Dict[str, Any]) -> dict:
    fid = payload.get('format_id')
    if not fid:
        raise HTTPException(400, 'format_id required')
    fmt = get_format(fid)
    finding = payload.get('finding') or {}
    evidence = payload.get('evidence') or {}
    mitigation = payload.get('mitigation') or {}
    content = render_report(fmt, finding, evidence, mitigation)
    return {'content': content}

@router.post('/finalize')
async def finalize(payload: Dict[str, Any]) -> dict:
    run_id = payload.get('run_id')
    mitigation = payload.get('mitigation') or {}
    duplicate_check = payload.get('duplicate_check')  # expected: {'status': 'unknown'|'clear'|'suspect', ...}
    if not run_id:
        raise HTTPException(400, 'run_id required')
    if not mitigation.get('plan'):
        raise HTTPException(409, 'mitigation_plan_required')
    if not has_recording(run_id):
        raise HTTPException(409, 'screen_recording_required')
    if duplicate_check not in (None, {}) and duplicate_check.get('status') == 'suspect':
        raise HTTPException(409, 'duplicate_suspected')
    return {'status': 'ready_for_hil_review', 'run_id': run_id}

@router.post('/submit')
async def submit(payload: Dict[str, Any]) -> dict:
    # Never auto-submit; require HiL approval path handled elsewhere.
    return {'status': 'blocked', 'reason': 'hil_required_for_submission'}


@router.post('/validate')
async def validate(payload: Dict[str, Any]) -> dict:
    fid = payload.get('format_id')
    if not fid:
        raise HTTPException(400, 'format_id required')
    fmt = get_format(fid)
    finding = payload.get('finding') or {}
    evidence = payload.get('evidence') or {}
    mitigation = payload.get('mitigation') or {}
    run_id = payload.get('run_id')
    content = render_report(fmt, finding, evidence, mitigation)
    stakeholder = fmt.get('stakeholder', 'generic')
    result = validate_rendered(stakeholder, content, run_id=run_id, has_recording=bool(payload.get('has_recording')))
    return {'ok': result['ok'], 'result': result, 'content': content}

@router.post('/submit_hil')
async def submit_hil(payload: Dict[str, Any]) -> dict:
    # Strictly HiL-only: requires hil_approved true, duplicate clear, and recording present
    run_id = payload.get('run_id')
    fid = payload.get('format_id')
    if not run_id or not fid:
        raise HTTPException(400, 'run_id and format_id required')
    if not payload.get('hil_approved'):
        raise HTTPException(403, 'hil_approval_required')
    dup = (payload.get('duplicate_check') or {}).get('status', 'unknown')
    if dup != 'clear':
        raise HTTPException(409, 'duplicate_not_cleared')
    fmt = get_format(fid)
    finding = payload.get('finding') or {}
    evidence = payload.get('evidence') or {}
    mitigation = payload.get('mitigation') or {}
    content = render_report(fmt, finding, evidence, mitigation)
    v = validate_rendered(fmt.get('stakeholder','generic'), content, run_id=run_id, has_recording=True)
    if not v.get('ok'):
        raise HTTPException(409, f"format_validation_failed: {v}")
    meta = { 'run_id': run_id, 'format_id': fid, 'stakeholder': fmt.get('stakeholder'), 'hil_approved': True, 'duplicate_check': 'clear' }
    saved = persist_submission(run_id, content, meta)
    return { 'status': 'queued_for_submission_by_operator', 'artifacts': saved }


@router.post('/package')
async def package(payload: Dict[str, Any]) -> dict:
    run_id = payload.get('run_id'); fid = payload.get('format_id')
    if not run_id or not fid:
        raise HTTPException(400, 'run_id and format_id required')
    if not payload.get('hil_approved'):
        raise HTTPException(403, 'hil_approval_required')
    if not has_recording(run_id):
        raise HTTPException(409, 'screen_recording_required')
    fmt = get_format(fid)
    stakeholder = fmt.get('stakeholder','generic')
    ctx = {
        'run_id': run_id,
        'finding': payload.get('finding') or {},
        'evidence': payload.get('evidence') or {},
        'mitigation': payload.get('mitigation') or {},
        'hil_approved': True,
        'duplicate_check': payload.get('duplicate_check') or {}
    }
    from core.packager import build_submission_package
    out = build_submission_package(run_id, stakeholder, ctx)
    return {'status': 'packaged', 'package': out}


@router.post('/duplicate_check')
async def duplicate_check(payload: Dict[str, Any]) -> dict:
    title = (payload.get('finding') or {}).get('title') or payload.get('title')
    if not title:
        raise HTTPException(400, 'title required')
    from core.duplicates import check_title_duplicate
    res = check_title_duplicate(title)
    return {'duplicate_check': res}
