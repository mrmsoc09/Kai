{
  "target": "*.adobe.com",
  "mode": "plan",
  "requires_hil": true,
  "notes": "Ethical Dorking preview only. Use Google CSE API when executing; respect robots/ToS; throttle.",
  "dorks": [
    {"query": "site:adobe.com inurl:admin"},
    {"query": "site:*.adobe.com inurl:login | inurl:signin | intitle:\"Sign in\""},
    {"query": "site:*.adobe.com ext:env | ext:yml | ext:yaml \"AWS_ACCESS_KEY_ID\""},
    {"query": "site:*.adobe.com \"index of\" (backup | .git | .svn | .env)"},
    {"query": "site:*.adobe.com (\"Stack trace\" | \"Exception in\" | \"Fatal error\")"},
    {"query": "site:*.adobe.com inurl:/.git/ | inurl:.svn/ | inurl:.DS_Store"},
    {"query": "site:*.adobe.com (\"Content-Security-Policy\" | CSP) report-uri"},
    {"query": "site:*.adobe.com (\"server: nginx\" | \"server: apache\") -www.adobe.com"},
    {"query": "site:*.adobe.com inurl:graphql | inurl:graphiql | intitle:GraphQL"},
    {"query": "site:*.adobe.com (\"index of\" and (\"config\" | \"logs\" | \"exports\"))"},
    {"query": "site:*.adobe.com ext:json \"password\" -policy -docs"},
    {"query": "site:*.adobe.com ext:conf | ext:cfg | ext:ini \"secret\""},
    {"query": "site:*.adobe.com inurl:\"/.well-known/security.txt\""},
    {"query": "site:*.adobe.com (\"Adobe Experience Manager\" | AEM) (inurl:system/console | intitle:Osgi)"},
    {"query": "site:*.adobe.com (\"Magento\" | \"Adobe Commerce\") inurl:admin"},
    {"query": "site:*.adobe.com (\"Elasticsearch\" | Kibana) intitle:Kibana"}
  ]
}
