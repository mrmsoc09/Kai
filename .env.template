# K1 SOVEREIGN ENVIRONMENT TEMPLATE
# =================================

# --- Sovereign Network Layer ---
# Startup hard-fails when sovereign network checks fail.
K1_ENFORCE_SOVEREIGN_NETWORK=true
K1_VPN_ALLOWED_INTERFACES=tun0,wg0
K1_VPN_BRIDGE_INTERFACE=
K1_ACTIVE_VPN_INTERFACE=
K1_VPN_CHECK_IP=1.1.1.1
K1_EGRESS_IP_API=https://ipinfo.io/ip
# Set to known local ISP/home CIDR ranges to block direct ISP egress.
K1_LOCAL_ISP_CIDRS=
K1_USE_PROXIES=false
K1_RESIDENTIAL_PROXY_URL=
K1_PROXY_HEALTHCHECK_URL=https://example.com
K1_PROXY_HEAD_TIMEOUT_SECONDS=10
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost,postgres,redis,vault,ollama

# --- Cloud Infrastructure (Burner Fleet) ---
# Managed via infra_manager.py
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
GCP_PROJECT_ID=
DO_TOKEN=
ORACLE_USER_OCID=
ORACLE_TENANCY_OCID=
ORACLE_FINGERPRINT=

# --- Core API Keys ---
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
VIRUSTOTAL_API_KEY=
GITHUB_TOKEN=
GEMINI_API_KEY=

# --- Backend Config ---
K1_DEV_TOKEN=dev-token-change-me
POSTGRES_PASSWORD=k1_pass_secure
