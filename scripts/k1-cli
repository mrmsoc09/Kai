#!/usr/bin/env python3
"""
Kai K1 Operator CLI
===================
CLI tool for operators to manage missions, approvals, and artifacts.
"""

import os
import sys
import json
import argparse
import requests
from typing import Any

# Default configuration
BASE_URL = os.getenv("K1_API_URL", "http://localhost:8080")
DEV_TOKEN = os.getenv("K1_DEV_TOKEN", "ci-token")

def get_auth_header():
    """Get the Authorization header using the dev token."""
    # Attempt to login to get a real JWT if needed, or just use dev token if enabled
    try:
        resp = requests.post(f"{BASE_URL}/auth/login", json={"token": DEV_TOKEN}, timeout=5)
        if resp.status_code == 200:
            token = resp.json().get("access_token")
            return {"Authorization": f"Bearer {token}"}
    except Exception:
        pass
    
    # Fallback to dev token directly (some endpoints might accept it)
    return {"Authorization": f"Bearer {DEV_TOKEN}"}

def format_json(data: Any) -> str:
    return json.dumps(data, indent=2)

# -- Command Handlers ---------------------------------------------------------

def mission_list(args):
    resp = requests.get(f"{BASE_URL}/missions/", headers=get_auth_header())
    if resp.status_code != 200:
        print(f"Error: {resp.text}")
        return
    print(format_json(resp.json()))

def mission_start(args):
    payload = {
        "workflow_id": args.workflow,
        "program_id": args.program,
        "mission_name": args.name or f"mission_{args.workflow}",
        "execution_mode": args.mode
    }
    # 1. Create
    resp = requests.post(f"{BASE_URL}/missions/", json=payload, headers=get_auth_header())
    if resp.status_code != 200:
        print(f"Error creating mission: {resp.text}")
        return
    
    mission_id = resp.json()["mission_id"]
    print(f"Created mission: {mission_id}")
    
    # 2. Start
    resp = requests.post(f"{BASE_URL}/missions/{mission_id}/start", headers=get_auth_header())
    if resp.status_code == 200:
        print(f"Started mission: {mission_id}")
    else:
        print(f"Error starting mission: {resp.text}")

def mission_stop(args):
    resp = requests.post(f"{BASE_URL}/missions/{args.id}/stop", headers=get_auth_header())
    print(format_json(resp.json()))

def mission_replay(args):
    resp = requests.post(f"{BASE_URL}/missions/{args.id}/replay", headers=get_auth_header())
    print(format_json(resp.json()))

def artifact_list(args):
    resp = requests.get(f"{BASE_URL}/artifacts/mission/{args.mission_id}", headers=get_auth_header())
    print(format_json(resp.json()))

def approval_list(args):
    resp = requests.get(f"{BASE_URL}/approvals/", headers=get_auth_header())
    print(format_json(resp.json()))

def approval_decide(args):
    endpoint = "approve" if args.action == "approve" else "reject"
    url = f"{BASE_URL}/approvals/{args.id}/{endpoint}"
    resp = requests.post(url, params={"notes": args.note}, headers=get_auth_header())
    print(format_json(resp.json()))

# -- CLI Entrypoint -----------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(description="Kai K1 Operator CLI")
    subparsers = parser.add_subparsers(dest="command", help="Command to execute")

    # Missions
    mission_parser = subparsers.add_parser("mission", help="Mission management")
    mission_sub = mission_parser.add_subparsers(dest="subcommand")
    
    mission_sub.add_parser("list", help="List missions")
    
    start_parser = mission_sub.add_parser("start", help="Start a mission")
    start_parser.add_argument("--workflow", required=True, help="Workflow ID")
    start_parser.add_argument("--program", required=True, help="Program ID")
    start_parser.add_argument("--name", help="Mission name")
    start_parser.add_argument("--mode", default="live", choices=["live", "graph_only", "tool_mock", "replay"], help="Execution mode")
    
    stop_parser = mission_sub.add_parser("stop", help="Stop a mission")
    stop_parser.add_argument("id", help="Mission ID")
    
    replay_parser = mission_sub.add_parser("replay", help="Replay a mission")
    replay_parser.add_argument("id", help="Mission ID")

    # Artifacts
    artifact_parser = subparsers.add_parser("artifact", help="Artifact browser")
    artifact_sub = artifact_parser.add_subparsers(dest="subcommand")
    
    art_list_parser = artifact_sub.add_parser("list", help="List artifacts for a mission")
    art_list_parser.add_argument("mission_id", help="Mission ID")

    # Approvals
    approval_parser = subparsers.add_parser("approvals", help="Governance approvals")
    approval_sub = approval_parser.add_subparsers(dest="subcommand")
    
    approval_sub.add_parser("list", help="List pending approvals")
    
    decide_parser = approval_sub.add_parser("decide", help="Approve or reject a gate")
    decide_parser.add_argument("id", help="Gate ID")
    decide_parser.add_argument("action", choices=["approve", "reject"], help="Decision")
    decide_parser.add_argument("--note", help="Operator note")

    args = parser.parse_args()

    if args.command == "mission":
        if args.subcommand == "list": mission_list(args)
        elif args.subcommand == "start": mission_start(args)
        elif args.subcommand == "stop": mission_stop(args)
        elif args.subcommand == "replay": mission_replay(args)
    elif args.command == "artifact":
        if args.subcommand == "list": artifact_list(args)
    elif args.command == "approvals":
        if args.subcommand == "list": approval_list(args)
        elif args.subcommand == "decide": approval_decide(args)
    else:
        parser.print_help()

if __name__ == "__main__":
    main()
