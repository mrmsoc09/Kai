# K1 Development Dockerfile
# Used by docker-compose.dev.yml

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    postgresql-client \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set Python environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_PREFER_BINARY=1

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --upgrade pip setuptools wheel && \
    pip install --use-deprecated=legacy-resolver -r requirements.txt

# Copy application code
COPY . .

# Create artifact directories
RUN mkdir -p artifacts/{logs,evidence,dork_runs,reports,submissions} && \
    mkdir -p data/{dorks,nuclei_templates}

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Default command (overridden by docker-compose)
CMD ["python3", "-m", "uvicorn", "apps.backend.src.main:app", "--host", "0.0.0.0", "--port", "8080"]
