# Stage 1: Build/Install Go tools
FROM golang:1.25-bookworm AS go-builder

# Install build dependencies
# libpcap-dev is required for naabu
RUN apt-get update && apt-get install -y git ca-certificates libpcap-dev curl

# Install ProjectDiscovery Suite
RUN go install github.com/projectdiscovery/subfinder/v2/cmd/subfinder@v2.14.0
RUN go install github.com/projectdiscovery/naabu/v2/cmd/naabu@v2.6.0
RUN go install github.com/projectdiscovery/httpx/cmd/httpx@v1.9.0
RUN go install github.com/projectdiscovery/nuclei/v3/cmd/nuclei@v3.8.0
RUN go install github.com/projectdiscovery/katana/cmd/katana@v1.6.0
RUN go install github.com/projectdiscovery/chaos-client/cmd/chaos@v0.5.2
RUN go install github.com/projectdiscovery/uncover/cmd/uncover@v1.2.0
RUN go install github.com/projectdiscovery/dnsx/cmd/dnsx@v1.1.4
RUN go install github.com/projectdiscovery/tlsx/cmd/tlsx@v1.2.0
RUN go install github.com/ffuf/ffuf/v2@v2.1.0

# TruffleHog installation
# TruffleHog cannot be installed via `go install` because its go.mod contains
# replace directives, which Go prohibits in versioned installs.
# Build from source instead so replace directives are honoured as main module.
RUN git clone --depth 1 --branch v3.95.2 \
        https://github.com/trufflesecurity/trufflehog.git /tmp/trufflehog \
    && cd /tmp/trufflehog \
    && go build -o /go/bin/trufflehog . \
    && rm -rf /tmp/trufflehog

# Amass v4 — v5 requires libpostal (C library, not in any standard package repo)
RUN go install github.com/owasp-amass/amass/v4/...@v4.2.0

# Stage 2: Final Worker Image
FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates curl wget git jq python3 python3-pip python3-venv \
      libssl-dev libffi-dev build-essential \
      libimage-exiftool-perl \
      libpcap0.8 \
      whois nmap dnsutils bsdmainutils && \
    rm -rf /var/lib/apt/lists/* && \
    mkdir -p /usr/share/wordlists

# Copy Go binaries from builder
COPY --from=go-builder /go/bin/* /usr/local/bin/

# Install theHarvester from Source
# theHarvester uses pyproject.toml (no requirements.txt since v4.x)
RUN git clone https://github.com/laramies/theHarvester.git --branch 4.10.1 --depth 1 /opt/theHarvester && \
    cd /opt/theHarvester && \
    pip install . --break-system-packages

# Install Celery + all deps required by the worker task (core backend imports)
# httpx pinned to match backend; heavy ML stack (llama-index, chromadb) excluded
RUN pip install --no-cache-dir \
    celery>=5.4 \
    redis>=5.0.2 \
    httpx==0.28.1 \
    fastapi>=0.115 \
    pydantic>=2.8 \
    pydantic-settings>=2.3 \
    PyYAML>=6.0.2 \
    python-dotenv>=1.0.1 \
    SQLAlchemy>=2.0.36 \
    asyncpg>=0.29 \
    psycopg2-binary>=2.9.11 \
    aiohttp>=3.9 \
    requests>=2.32.5 \
    cryptography>=42.0 \
    python-jose[cryptography]>=3.3.1 \
    passlib[bcrypt]>=1.7.4 \
    orjson>=3.10 \
    anthropic>=0.31 \
    openai>=1.33 \
    google-generativeai>=0.5.4 \
    hvac>=2.1.0 \
    networkx>=3.3 \
    --break-system-packages

WORKDIR /app
COPY . /app

# Default command: start Celery worker
CMD ["bash", "-lc", "cd /app && celery -A apps.backend.src.worker.celery_app worker -Q tools,intrusive -l info"]
